  "smsScripts": [
    {
      "id": "sms-wan-1",
      "contactId": "wan",
      "messages": [
        {
          "side": "them",
          "text": "又不回我微信！",
          "afterMs": 1200
        },
        {
          "side": "them",
          "text": "boss你只知道回你置顶瑶瑶姐的消息",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "工作上的我都回复了",
          "keystrokes": "gongzuoshangdewodouhuifule"
        },
        {
          "side": "them",
          "text": "哎一个头两个大，老板还沉迷恋爱不管员工死活",
          "afterMs": 1000
        },
        {
          "side": "me",
          "text": "我昨天才和你通了电话，今天是我休息日",
          "keystrokes": "wozuotiancaihenitongledianhuajintianshiwoxiuxiri"
        },
        {
          "side": "them",
          "text": "谢谢老板的安慰和涨的工资",
          "afterMs": 1000
        },
        {
          "side": "them",
          "text": "行，不打扰你和你家瑶瑶了",
          "afterMs": 1000
        },
        {
          "side": "them",
          "text": "记得有空看一下本月的问题反馈",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "嗯，知道的，你也去好好休息吧",
          "keystrokes": "enzhidaodeniyequhaohaoxiuxiba"
        }
      ]
    }
  ],
  "phoneDialogues": [
    {
      "id": "incoming-yao-bridge1",
      "contactId": "yao",
      "direction": "incoming",
      "hangupAfterMs": 4000,
      "conversation": [
        {
          "side": "them",
          "text": "喂，月月？",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "嗯，怎么了瑶瑶，不是在参加活动吗？",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "中途溜出来透气了",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "很无聊吗？",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "有点。",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "但主要是——",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "主要是？",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "想你了。",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "想听你的声音。",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "……我也想你。",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "结束以后还是我来接你吧？",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "这么好呀月月？",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "嗯，可以吗？想见你。",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "当然可以了。",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "要回去工作了。",
          "afterMs": 1800
        },
        {
          "side": "them",
          "text": "等你哦。",
          "afterMs": 1800
        },
        {
          "side": "me",
          "text": "拜拜，工作加油。",
          "afterMs": 1800
        }
      ]
    },
